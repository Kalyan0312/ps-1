# ==============================================================================
# Cooperative Gig Platform - Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="Cooperative Gig Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (PostgreSQL + PostGIS)
# Async driver: postgresql+asyncpg
# Sync driver (for Alembic): postgresql+psycopg2
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="gig_user"
POSTGRES_PASSWORD="gig_password"
POSTGRES_DB="cooperative_gig"
DATABASE_URL="postgresql+asyncpg://gig_user:gig_password@localhost:5432/cooperative_gig"
SYNC_DATABASE_URL="postgresql+psycopg2://gig_user:gig_password@localhost:5432/cooperative_gig"

# Speech-to-Text (Google Cloud)
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_CLOUD_PROJECT=""

# Payments (Razorpay / UPI Gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_CREDENTIALS_PATH=""

# Forecasting Settings
FORECASTING_MODEL_TYPE="baseline" # options: prophet, baseline, regression

# Real-time WebSockets
WS_HEARTBEAT_INTERVAL=30
